{"dataSourceLinksInfo":{"enableAutomaticLinking":false,"excludeRelationships":[],"links":[]},"filters":[],"gridLayouts":[{"name":"Default","numColumns":30,"pages":[{"label":"Untitled","name":"9ac4363e-22a7-49c4-880b-f05722fca7a0","navigationHidden":false,"widgets":[{"colspan":30,"column":0,"name":"text_1","row":0,"rowspan":4,"widgetStyle":{"borderEdges":[]}},{"colspan":30,"column":0,"name":"number_1","row":4,"rowspan":4,"widgetStyle":{"borderEdges":[]}}]}],"rowHeight":"fine","selectors":[],"style":{"alignmentX":"left","alignmentY":"top","backgroundColor":"#F2F6FA","cellSpacingX":0,"cellSpacingY":0,"fit":"original","gutterColor":"#C5D3E0"},"version":1.0}],"layouts":[],"steps":{"Retention_Rate_1":{"broadcastFacet":true,"groups":[],"label":"Retention Rate","numbers":[],"query":"q = load \"FSC_INS_Insurance_Policy\";\nq_B = filter q by 'CancellationDate_sec_epoch' is not null;\nq_C = filter q by 'CancellationDate_sec_epoch' is not null and 'DateRenewed_sec_epoch' is not null and  date('RenewalDate_Year', 'RenewalDate_Month', 'RenewalDate_Day') in [..\"current day\"];\nresult = group q by all full, q_B by all full, q_C by all;\nresult = foreach result generate unique(q.'Id') as 'A', unique(q_B.'Id') as 'B', unique(q_C.'Id') as 'C', (unique(q.'Id') - (coalesce(unique(q_B.'Id'),0) + coalesce(unique(q_C.'Id') ,0)))*100/unique(q.'Id') as 'Retention Rate' ;\nresult = limit result 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,