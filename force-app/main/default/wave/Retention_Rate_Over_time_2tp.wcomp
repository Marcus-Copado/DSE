{"dataSourceLinksInfo":{"enableAutomaticLinking":false,"excludeRelationships":[],"links":[]},"filters":[],"gridLayouts":[{"name":"Default","numColumns":30,"pages":[{"label":"Untitled","name":"c52c2373-dd33-4900-aab8-38bc492b8263","navigationHidden":false,"widgets":[{"colspan":30,"column":0,"name":"text_1","row":0,"rowspan":4,"widgetStyle":{"borderEdges":[]}},{"colspan":30,"column":0,"name":"chart_1","row":4,"rowspan":31,"widgetStyle":{"borderEdges":[]}}]}],"rowHeight":"fine","selectors":[],"style":{"alignmentX":"left","alignmentY":"top","backgroundColor":"#F2F6FA","cellSpacingX":0,"cellSpacingY":0,"fit":"original","gutterColor":"#C5D3E0"},"version":1.0}],"layouts":[],"steps":{"RetentionRate_Overti_1":{"broadcastFacet":true,"groups":[],"label":"RetentionRate_Overtime","numbers":[],"query":"q = load \"FSC_INS_Insurance_Policy\";\n\nq_B = filter q by 'CancellationDate_sec_epoch' is not null;\nq_C = filter q by 'CancellationDate_sec_epoch' is not null and 'DateRenewed_sec_epoch' is not null and  date('RenewalDate_Year', 'RenewalDate_Month', 'RenewalDate_Day') in [..\"current day\"];\nresult = group q by  ('RenewalDate_Year', 'RenewalDate_Month') full, q_B by ('RenewalDate_Year', 'RenewalDate_Month') full, q_C by ('RenewalDate_Year', 'RenewalDate_Month');\nresult = foreach result generate q.'RenewalDate_Year' + \"~~~\" + q.'RenewalDate_Month' as 'RenewalDate_Year~~~RenewalDate_Month',(unique(q.'Id') - (coalesce(unique(q_B.'Id'),0) + coalesce(unique(q_C.'Id') ,0)))*100/unique(q.'Id') as 'Retention Rate' ;\nresult = limit result 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize